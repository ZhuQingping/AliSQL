--source include/have_binlog_format_mixed_or_row.inc

SET GLOBAL vidx_disabled = OFF;
SET transaction_isolation = 'READ-COMMITTED';
GRANT AI_INVOKE, AI_ADMIN ON *.* TO 'root'@'localhost';

--echo # Debug-only fixture Profiles never contact a provider or read a secret.
CALL dbms_ai.register_model('mtr/fixture-embedding', 'TEXT_EMBEDDING',
                            'fixture-embedding', 'SECRET_REF', 'mtr/not-read');
CALL dbms_ai.register_model('mtr/fixture-chat', 'TEXT_GENERATION',
                            'fixture-chat', 'SECRET_REF', 'mtr/not-read');

CREATE TABLE rag_manual_chunk (
  tenant_id BIGINT UNSIGNED NOT NULL,
  source_id VARCHAR(64) NOT NULL,
  chunk_id INT NOT NULL,
  product_line VARCHAR(32) NOT NULL,
  access_label ENUM('internal','support') NOT NULL,
  content TEXT NOT NULL,
  embedding VECTOR(1024) NOT NULL,
  embedding_model VARCHAR(128) NOT NULL,
  embedding_config_version BIGINT UNSIGNED NOT NULL,
  embedding_space_id VARCHAR(128) NOT NULL,
  PRIMARY KEY (tenant_id, source_id, chunk_id),
  KEY ix_tenant_product (tenant_id, product_line, access_label),
  VECTOR INDEX ix_manual_embedding (embedding) m=3 distance=cosine,
  CONSTRAINT ck_embedding_contract CHECK
    (embedding_config_version = 1 AND
     embedding_space_id = 'mtr/fixture/1024/cosine')
) ENGINE=InnoDB;

INSERT INTO rag_manual_chunk
  (tenant_id, source_id, chunk_id, product_line, access_label, content,
   embedding, embedding_model, embedding_config_version, embedding_space_id)
VALUES
  (42, 'manual-42', 1, 'gateway', 'support', 'Tenant 42 gateway procedure.',
   AI_EMBEDDING('Tenant 42 gateway procedure.', 'mtr/fixture-embedding', 1024),
   'mtr/fixture-embedding', 1, 'mtr/fixture/1024/cosine'),
  (77, 'manual-77', 1, 'gateway', 'support', 'Tenant 77 private procedure.',
   AI_EMBEDDING('Tenant 77 private procedure.', 'mtr/fixture-embedding', 1024),
   'mtr/fixture-embedding', 1, 'mtr/fixture/1024/cosine');

--echo # The retrieval query keeps tenant and business predicates in SQL.
SET @query_embedding = AI_EMBEDDING('How do I handle an offline gateway?',
                                    'mtr/fixture-embedding', 1024);
SELECT source_id, chunk_id, content
  FROM rag_manual_chunk
 WHERE tenant_id = 42
   AND product_line = 'gateway'
   AND access_label = 'support'
   AND embedding_model = 'mtr/fixture-embedding'
   AND embedding_config_version = 1
   AND embedding_space_id = 'mtr/fixture/1024/cosine'
 ORDER BY VEC_DISTANCE_COSINE(embedding, @query_embedding), source_id
 LIMIT 8;

--echo # A mismatched embedding-space/version contract is rejected on write.
--error ER_CHECK_CONSTRAINT_VIOLATED
INSERT INTO rag_manual_chunk
  (tenant_id, source_id, chunk_id, product_line, access_label, content,
   embedding, embedding_model, embedding_config_version, embedding_space_id)
VALUES
  (42, 'invalid-space', 1, 'gateway', 'support', 'must fail',
   AI_EMBEDDING('must fail', 'mtr/fixture-embedding', 1024),
   'mtr/fixture-embedding', 2, 'mtr/fixture/other');

--echo # STORED generated vectors synchronously embed document writes and updates.

CREATE TABLE knowledge_base (
  id INT AUTO_INCREMENT PRIMARY KEY,
  doc TEXT NOT NULL,
  category VARCHAR(32) NOT NULL DEFAULT 'general',
  vec VECTOR(1024)
    AS (AI_EMBEDDING(doc, 'mtr/fixture-embedding', 1024)) STORED,
  VECTOR INDEX ix_knowledge_vec (vec) m=3 distance=cosine
) ENGINE=InnoDB;

INSERT INTO knowledge_base (doc) VALUES
  ('TaurusDB improves MySQL-compatible database throughput.'),
  ('A database instance can grow to 128 TB of storage.'),
  ('Read replicas offload pressure from the primary node.'),
  ('Snapshots are retained and can be restored to a point in time.');

SELECT id, VECTOR_DIM(vec) AS dimension
  FROM knowledge_base
 ORDER BY id;

UPDATE knowledge_base
   SET doc = 'Read replicas offload pressure from the primary database node.'
 WHERE id = 3;
SET @rag_original_binlog_row_image = @@SESSION.binlog_row_image;
SET SESSION binlog_row_image = 'MINIMAL';
UPDATE knowledge_base SET category = 'operations' WHERE id = 3;

SET @knowledge_query = AI_EMBEDDING(
  'How can read traffic be offloaded?', 'mtr/fixture-embedding', 1024);
SELECT id, doc, VEC_DISTANCE(vec, @knowledge_query) AS distance
  FROM knowledge_base FORCE INDEX (ix_knowledge_vec)
 ORDER BY VEC_DISTANCE(vec, @knowledge_query), id
 LIMIT 2;

DROP TABLE knowledge_base;
SET SESSION binlog_row_image = @rag_original_binlog_row_image;

--echo # RAG output is paired with database-generated source metadata.
SET @rag_input = NULL;
SELECT JSON_OBJECT(
         'question', 'How do I handle an offline gateway?',
         'sources', JSON_ARRAYAGG(JSON_OBJECT('source_id', source_id,
                                               'chunk_id', chunk_id,
                                               'content', content)))
  INTO @rag_input
  FROM (
    SELECT source_id, chunk_id, content
      FROM rag_manual_chunk
     WHERE tenant_id = 42
       AND product_line = 'gateway'
       AND access_label = 'support'
       AND embedding_model = 'mtr/fixture-embedding'
       AND embedding_config_version = 1
       AND embedding_space_id = 'mtr/fixture/1024/cosine'
     ORDER BY source_id, chunk_id
     LIMIT 8
  ) AS permitted_rag_sources;
SELECT JSON_EXTRACT(AI_ANALYZE(
  'Answer from supplied database chunks only.',
  @rag_input,
  JSON_OBJECT('model_name', 'mtr/fixture-chat', 'mode', 'rag',
              'output_format', 'json', 'return_sources', true)),
  '$.sources') AS rag_sources;

--echo # RAG must receive source chunks from the SQL retrieval path.
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE(
  'Answer from supplied database chunks only.',
  JSON_OBJECT('question', 'How do I handle an offline gateway?'),
  JSON_OBJECT('model_name', 'mtr/fixture-chat', 'mode', 'rag',
              'output_format', 'json', 'return_sources', true));

--echo # Source provenance cannot be requested from a text RAG response.
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE(
  'Answer from supplied database chunks only.',
  JSON_OBJECT('question', 'How do I handle an offline gateway?',
              'sources', JSON_ARRAY(JSON_OBJECT('source_id', 'manual-42',
                                                'chunk_id', 1,
                                                'content', 'Tenant 42 gateway procedure.'))),
  JSON_OBJECT('model_name', 'mtr/fixture-chat', 'mode', 'rag',
              'output_format', 'text', 'return_sources', true));
SELECT JSON_ARRAYAGG(JSON_OBJECT('source_id', source_id, 'chunk_id', chunk_id))
       AS sources
  FROM rag_manual_chunk
 WHERE tenant_id = 42 AND source_id = 'manual-42';

DROP TABLE rag_manual_chunk;
CALL dbms_ai.delete_model('mtr/fixture-embedding', 'TEXT_EMBEDDING');
CALL dbms_ai.delete_model('mtr/fixture-chat', 'TEXT_GENERATION');
SET GLOBAL vidx_disabled = ON;
