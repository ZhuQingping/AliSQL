--source include/have_binlog_format_row.inc
--source include/master-slave.inc

--source include/rpl_connection_master.inc
SET GLOBAL rds_ai_maas = ON;
GRANT AI_ADMIN ON *.* TO 'root'@'localhost';
CALL dbms_ai.register_model('huawei/mtr-model-admin-rpl', 'TEXT_GENERATION',
                            'huawei', 'glm-5.2',
                            'https://api.modelarts-maas.com/v2/chat/completions', 0, '{}');

--source include/rpl_sync.inc
--source include/rpl_connection_slave.inc
SELECT model_name, provider_model_name, config_version
  FROM mysql.ai_model_config
 WHERE model_name = 'huawei/mtr-model-admin-rpl' AND status = 'ACTIVE';

--source include/rpl_connection_master.inc
CALL dbms_ai.delete_model('huawei/mtr-model-admin-rpl', 'TEXT_GENERATION');
--source include/rpl_sync.inc
--source include/rpl_connection_slave.inc
SELECT COUNT(*) AS active_profiles
  FROM mysql.ai_model_config
 WHERE model_name = 'huawei/mtr-model-admin-rpl' AND status = 'ACTIVE';

--source include/rpl_end.inc
SET GLOBAL rds_ai_maas = OFF;
