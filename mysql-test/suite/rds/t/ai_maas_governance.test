--echo # The MaaS feature is disabled by default and rejects data-plane calls before privilege/Profile/audit work.
SELECT @@GLOBAL.rds_ai_maas AS maas_default;
--error ER_NOT_SUPPORTED_YET
SELECT AI_EMBEDDING('mtr/fixture-embedding', 'feature-off',
                    JSON_OBJECT('dimension', 1024));
--error ER_NOT_SUPPORTED_YET
SELECT AI_ANALYZE('mtr/fixture-chat', 'feature-off');
GRANT AI_ADMIN ON *.* TO 'root'@'localhost';
--echo # Read-only model discovery remains available while the feature is disabled.
CALL dbms_ai.show_models();
--error ER_NOT_SUPPORTED_YET
CALL dbms_ai.register_model('mtr/feature-off', 'TEXT_EMBEDDING', 'mtr',
                            'fixture-embedding',
                            'https://db4ai-mtr-fixture.invalid/v1/embeddings', 1024, '{}');
SET GLOBAL rds_ai_maas = ON;
SELECT @@GLOBAL.rds_ai_maas AS maas_enabled;

--echo # AI invocation audit is globally enabled by default and has no SESSION scope.
CALL mtr.add_suppression("AUDIT_TERMINAL_WRITE_FAILED");
SELECT @@GLOBAL.ai_invoke_audit AS audit_default;

CREATE USER 'ai_audit_reader'@'localhost';
GRANT AI_INVOKE ON *.* TO 'ai_audit_reader'@'localhost';
--connect (reader,localhost,ai_audit_reader,,test)
--echo # AI_INVOKE does not permit disabling the instance audit trail.
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
SET GLOBAL ai_invoke_audit = OFF;
--disconnect reader
--connection default

--echo # Administrators can dynamically control only the GLOBAL switch.
--error ER_GLOBAL_VARIABLE
SET SESSION ai_invoke_audit = OFF;
SET GLOBAL ai_invoke_audit = OFF;
SELECT @@GLOBAL.ai_invoke_audit AS audit_disabled;
SET GLOBAL ai_invoke_audit = ON;
SELECT @@GLOBAL.ai_invoke_audit AS audit_reenabled;

--echo # A terminal audit write failure preserves the Provider result after STARTED and logs only correlation metadata.
GRANT AI_ADMIN, AI_INVOKE ON *.* TO 'root'@'localhost';
CALL dbms_ai.register_model('mtr/fixture-embedding', 'TEXT_EMBEDDING', 'mtr',
                            'fixture-embedding',
                            'https://db4ai-mtr-fixture.invalid/v1/embeddings', 1024, '{}');
--echo # The fixed input ceiling rejects before audit or fixture dispatch.
--error ER_NOT_SUPPORTED_YET
SELECT AI_EMBEDDING('mtr/fixture-embedding', REPEAT('x', 1048577),
                    JSON_OBJECT('dimension', 1024));
CALL dbms_ai.register_model('mtr/fixture-chat', 'TEXT_GENERATION', 'mtr',
                            'fixture-chat',
                            'https://db4ai-mtr-fixture.invalid/v2/chat/completions', 0, '{}');
--error ER_NOT_SUPPORTED_YET
SELECT AI_ANALYZE('mtr/fixture-chat', REPEAT('x', 1048577));
SET debug = '+d,db4ai_audit_terminal_write_failure';
SELECT VECTOR_DIM(AI_EMBEDDING('mtr/fixture-embedding',
                               'request-secret-must-not-reach-the-error-log',
                               JSON_OBJECT('dimension', 1024)))
       AS audit_terminal_result;
SET debug = '';
--let $assert_text= Terminal audit failure has a call id, capability, and logical model only
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= AUDIT_TERMINAL_WRITE_FAILED
--let $assert_match= AUDIT_TERMINAL_WRITE_FAILED call_id=[1-9][0-9]* capability=TEXT_EMBEDDING model_name=mtr/fixture-embedding
--source include/assert_grep.inc
--let $assert_text= Terminal audit failure never writes request content to the error log
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= request-secret-must-not-reach-the-error-log
--let $assert_match=
--let $assert_count= 0
--source include/assert_grep.inc
CALL dbms_ai.delete_model('mtr/fixture-embedding', 'TEXT_EMBEDDING');
CALL dbms_ai.delete_model('mtr/fixture-chat', 'TEXT_GENERATION');

--echo # AI_AUDIT_VIEWER is not registered in the current release.
--error ER_SYNTAX_ERROR
GRANT AI_AUDIT_VIEWER ON *.* TO 'ai_audit_reader'@'localhost';
DROP USER 'ai_audit_reader'@'localhost';
SET GLOBAL rds_ai_maas = OFF;
