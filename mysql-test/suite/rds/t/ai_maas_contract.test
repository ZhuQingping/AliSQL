--echo # AI functions preserve NULL input without model resolution or egress.
SELECT AI_EMBEDDING(NULL, 'mtr/fixture-embedding', 1024);

--echo # AI calls require an explicit active Profile and remain offline with fixture credentials.
GRANT AI_ADMIN ON *.* TO 'root'@'localhost';
DELETE FROM mysql.taurusdb_ai_model_config
 WHERE model_name IN ('mtr/fixture-embedding', 'mtr/fixture-chat',
                      'mtr/contract-disabled', 'mtr/plaintext-probe');
INSERT INTO mysql.taurusdb_ai_model_config
  (model_name, provider, capability, provider_model_name, endpoint_url,
   credential_mode, credential_ref, default_dimension, is_default, status)
VALUES
  ('mtr/fixture-embedding', 'mtr', 'TEXT_EMBEDDING', 'fixture-embedding',
   'https://db4ai-mtr-fixture.invalid/v1/embeddings',
   'SECRET_REF', 'mtr/not-read', 1024, TRUE, 'ACTIVE'),
  ('mtr/fixture-chat', 'mtr', 'TEXT_GENERATION', 'fixture-chat',
   'https://db4ai-mtr-fixture.invalid/v2/chat/completions',
   'SECRET_REF', 'mtr/not-read', NULL, TRUE, 'ACTIVE'),
  ('mtr/contract-disabled', 'mtr', 'TEXT_EMBEDDING', 'contract-disabled',
   'https://db4ai-mtr-fixture.invalid/v1/embeddings',
   'SECRET_REF', 'mtr/not-read', 1024, FALSE, 'DISABLED');

GRANT AI_INVOKE ON *.* TO 'root'@'localhost';
--error ER_NOT_SUPPORTED_YET
SELECT AI_EMBEDDING('text');
--error ER_NOT_SUPPORTED_YET
SELECT AI_ANALYZE('task', JSON_OBJECT('x', 1));
SELECT VECTOR_DIM(AI_EMBEDDING('explicit profile', 'mtr/fixture-embedding', 1024))
  AS explicit_dimension;
SELECT AI_ANALYZE('Summarize only.', JSON_OBJECT('rows', 1),
                  JSON_OBJECT('model_name', 'mtr/fixture-chat',
                              'mode', 'analyze')) AS explicit_analysis;
SELECT JSON_UNQUOTE(JSON_EXTRACT(AI_MODEL_INFO('mtr/fixture-embedding'), '$.model_name'))
  AS explicit_model;

--echo # A disabled Profile is rejected locally before credentials or network access.
--error ER_NOT_SUPPORTED_YET
SELECT AI_EMBEDDING('disabled', 'mtr/contract-disabled', 1024);

--echo # Debug plaintext lookup uses the resolved Id and config_version before protocol rejection.
INSERT INTO mysql.taurusdb_ai_model_config
  (model_name, provider, capability, provider_model_name, endpoint_url,
   credential_mode, api_key_plaintext, default_dimension, status)
VALUES
  ('mtr/plaintext-probe', 'huawei', 'TEXT_EMBEDDING', 'bge-m3',
   'https://api.modelarts-maas.com/v1/not-embeddings',
   'PLAINTEXT_DEV', UNHEX('00'), 1024, 'ACTIVE');
--error ER_NOT_SUPPORTED_YET
SELECT AI_EMBEDDING('plaintext-probe', 'mtr/plaintext-probe', 1024);

--echo # Registered functions enforce their public arity.
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT AI_EMBEDDING();
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT AI_ANALYZE('task');
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT AI_MODEL_INFO('a', 'b');

DELETE FROM mysql.taurusdb_ai_model_config
 WHERE model_name IN ('mtr/fixture-embedding', 'mtr/fixture-chat',
                      'mtr/contract-disabled', 'mtr/plaintext-probe');
--source include/have_binlog_format_mixed_or_row.inc
