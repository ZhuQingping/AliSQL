SET GLOBAL rds_ai_maas = ON;
--echo # AI functions preserve NULL input without model resolution or egress.
SELECT AI_EMBEDDING('mtr/fixture-embedding', NULL,
                    JSON_OBJECT('dimension', 1024));

--echo # AI calls require an explicit active Profile and remain offline with fixture credentials.
GRANT AI_ADMIN ON *.* TO 'root'@'localhost';
CALL dbms_ai.register_model('mtr/fixture-embedding', 'TEXT_EMBEDDING', 'mtr',
                            'fixture-embedding',
                            'https://db4ai-mtr-fixture.invalid/v1/embeddings', 1024, '{}');
CALL dbms_ai.register_model('mtr/fixture-chat', 'TEXT_GENERATION', 'mtr',
                            'fixture-chat',
                            'https://db4ai-mtr-fixture.invalid/v2/chat/completions', 0, '{}');
CALL dbms_ai.register_model('huawei/mtr-contract-disabled', 'TEXT_EMBEDDING', 'huawei',
                            'bge-m3', 'https://api.modelarts-maas.com/v1/embeddings', 1024, '{}');
CALL dbms_ai.delete_model('huawei/mtr-contract-disabled', 'TEXT_EMBEDDING');

GRANT AI_INVOKE ON *.* TO 'root'@'localhost';
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT AI_EMBEDDING('text');
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT AI_ANALYZE('mtr/fixture-chat');
SELECT VECTOR_DIM(AI_EMBEDDING('mtr/fixture-embedding', 'explicit profile',
                               JSON_OBJECT('dimension', 1024)))
  AS explicit_dimension;
SELECT AI_ANALYZE('mtr/fixture-chat',
                  'Summarize only the supplied evidence.') AS explicit_analysis;
SELECT JSON_UNQUOTE(JSON_EXTRACT(AI_MODEL_INFO('mtr/fixture-embedding'), '$.model_name'))
  AS explicit_model;

--echo # A disabled Profile is rejected locally before credentials or network access.
--error ER_NOT_SUPPORTED_YET
SELECT AI_EMBEDDING('huawei/mtr-contract-disabled', 'disabled',
                    JSON_OBJECT('dimension', 1024));

--echo # A Huawei profile without a credential fails locally before transport.
CALL dbms_ai.register_model('huawei/mtr-no-credential', 'TEXT_EMBEDDING', 'huawei',
                            'bge-m3', 'https://api.modelarts-maas.com/v1/embeddings', 1024, '{}');
--error ER_NOT_SUPPORTED_YET
SELECT AI_EMBEDDING('huawei/mtr-no-credential', 'no-credential',
                    JSON_OBJECT('dimension', 1024));

--echo # Registered functions enforce their public arity.
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT AI_EMBEDDING();
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT AI_ANALYZE('task');
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT AI_MODEL_INFO('a', 'b');
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT AI_MODEL_INFO();

CALL dbms_ai.delete_model('mtr/fixture-embedding', 'TEXT_EMBEDDING');
CALL dbms_ai.delete_model('mtr/fixture-chat', 'TEXT_GENERATION');
CALL dbms_ai.delete_model('huawei/mtr-no-credential', 'TEXT_EMBEDDING');
--source include/have_binlog_format_mixed_or_row.inc
SET GLOBAL rds_ai_maas = OFF;
