--echo # dbms_ai accepts only the governed model-management package.
--disable_warnings
DROP USER IF EXISTS 'ai_model_admin_dml'@'localhost';
--enable_warnings
CREATE USER 'ai_model_admin_dml'@'localhost';
CREATE USER 'ai_model_admin_super'@'localhost';
GRANT SELECT, INSERT, UPDATE, DELETE, ALTER, DROP, INDEX
  ON mysql.taurusdb_ai_model_config
  TO 'ai_model_admin_dml'@'localhost';
GRANT SUPER ON *.* TO 'ai_model_admin_super'@'localhost';

--connect (model_admin_dml,localhost,ai_model_admin_dml,,test)
--echo # Table DML alone cannot administer models through the package.
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
CALL dbms_ai.register_model('mtr/model-admin-forbidden-embedding', 'TEXT_EMBEDDING',
                            'fixture-embedding', 'SECRET_REF', 'mtr/not-read');
--disconnect model_admin_dml
--connection default

--connect (model_admin_super,localhost,ai_model_admin_super,,test)
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
CALL dbms_ai.show_models();
--disconnect model_admin_super
--connection default

--echo # AI_ADMIN is sufficient for dbms_ai but never permits direct control-table writes.
GRANT AI_ADMIN ON *.* TO 'ai_model_admin_dml'@'localhost';
--connect (model_admin_dml,localhost,ai_model_admin_dml,,test)
--error ER_TABLEACCESS_DENIED_ERROR
INSERT INTO mysql.taurusdb_ai_model_config
  (model_name, provider, capability, provider_model_name, endpoint_url,
   credential_mode, credential_ref, default_dimension, status)
SELECT 'huawei/direct-insert-must-fail', 'huawei', 'TEXT_EMBEDDING', 'bge-m3',
       'https://api.modelarts-maas.com/v1/embeddings',
       'SECRET_REF', 'mtr/not-read', 1024, 'ACTIVE'
 WHERE FALSE;
--error ER_TABLEACCESS_DENIED_ERROR
UPDATE mysql.taurusdb_ai_model_config
   SET status = 'DISABLED'
 WHERE model_name = 'huawei/direct-update-must-fail';
--error ER_TABLEACCESS_DENIED_ERROR
DELETE FROM mysql.taurusdb_ai_model_config
 WHERE model_name = 'huawei/direct-delete-must-fail';
--error ER_TABLEACCESS_DENIED_ERROR
ALTER TABLE mysql.taurusdb_ai_model_config COMMENT = 'direct alter must fail';
--error ER_TABLEACCESS_DENIED_ERROR
DROP TABLE mysql.taurusdb_ai_model_config;
--error ER_TABLEACCESS_DENIED_ERROR
DROP INDEX direct_drop_must_fail ON mysql.taurusdb_ai_model_config;
--echo # The same account can write only through the governed native package.
CALL dbms_ai.register_model('huawei/model-admin-user-generation', 'TEXT_GENERATION',
                            'glm-5.2', 'SECRET_REF', 'mtr/not-read');
CALL dbms_ai.update_model('huawei/model-admin-user-generation', 'TEXT_GENERATION',
                          'kimi-k2.6', 'SECRET_REF', 'mtr/not-read');
CALL dbms_ai.delete_model('huawei/model-admin-user-generation', 'TEXT_GENERATION');
--disconnect model_admin_dml
--connection default

GRANT AI_ADMIN ON *.* TO 'root'@'localhost';
CALL dbms_ai.register_model('huawei/mtr-model-admin-generation', 'TEXT_GENERATION',
                            'glm-5.2', 'SECRET_REF', 'mtr/not-read');
--echo # The package makes its fixed bge-m3/1024 embedding contract resolvable.
CALL dbms_ai.register_model('huawei/mtr-model-admin-embedding', 'TEXT_EMBEDDING',
                            'bge-m3', 'SECRET_REF', 'mtr/not-read');
SELECT JSON_EXTRACT(AI_MODEL_INFO('huawei/mtr-model-admin-embedding'), '$.dimension');
CALL dbms_ai.delete_model('huawei/mtr-model-admin-embedding', 'TEXT_EMBEDDING');
--echo # Duplicate names and unsupported embedding profiles are rejected locally.
--error ER_WRONG_ARGUMENTS
CALL dbms_ai.register_model('huawei/mtr-model-admin-generation', 'TEXT_GENERATION',
                            'glm-5.2', 'SECRET_REF', 'mtr/not-read');
--error ER_WRONG_ARGUMENTS
CALL dbms_ai.register_model('huawei/mtr-invalid-embedding', 'TEXT_EMBEDDING',
                            'not-bge-m3', 'SECRET_REF', 'mtr/not-read');
--echo # PLAINTEXT_DEV is accepted by this Debug-only package test but never invoked.
CALL dbms_ai.register_model('huawei/mtr-plaintext-dev', 'TEXT_GENERATION',
                            'glm-5.2', 'PLAINTEXT_DEV', 'dev-only-not-invoked');
SELECT credential_mode
  FROM mysql.taurusdb_ai_model_config
 WHERE model_name = 'huawei/mtr-plaintext-dev' AND status = 'ACTIVE';
CALL dbms_ai.delete_model('huawei/mtr-plaintext-dev', 'TEXT_GENERATION');
--echo # The public model list exposes exactly safe lifecycle metadata.
CALL dbms_ai.show_models();
CALL dbms_ai.update_model('huawei/mtr-model-admin-generation', 'TEXT_GENERATION',
                          'kimi-k2.6', 'SECRET_REF', 'mtr/not-read');
--echo # Updating exposes only the replacement active configuration.
CALL dbms_ai.show_models();
--echo # Resolution observes only the successor and cannot invoke a provider.
SELECT JSON_EXTRACT(AI_MODEL_INFO('huawei/mtr-model-admin-generation'), '$.config_version');
--echo # A successor write failure rolls back and leaves version 2 active.
SET SESSION debug = '+d,inject_error_ha_write_row';
--error ER_UNKNOWN_ERROR
CALL dbms_ai.update_model('huawei/mtr-model-admin-generation', 'TEXT_GENERATION',
                          'should-not-persist', 'SECRET_REF', 'mtr/not-read');
SET SESSION debug = '-d,inject_error_ha_write_row';
SELECT JSON_EXTRACT(AI_MODEL_INFO('huawei/mtr-model-admin-generation'), '$.config_version');
CALL dbms_ai.delete_model('huawei/mtr-model-admin-generation', 'TEXT_GENERATION');
--echo # Deleting retires every version from the public model list.
CALL dbms_ai.show_models();
--error ER_NOT_SUPPORTED_YET
SELECT AI_MODEL_INFO('huawei/mtr-model-admin-generation');

REVOKE SELECT, INSERT, UPDATE, DELETE, ALTER, DROP, INDEX
  ON mysql.taurusdb_ai_model_config
  FROM 'ai_model_admin_dml'@'localhost';
DROP USER 'ai_model_admin_dml'@'localhost';
DROP USER 'ai_model_admin_super'@'localhost';
