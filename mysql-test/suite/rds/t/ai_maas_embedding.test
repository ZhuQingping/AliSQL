--echo # AI_EMBEDDING offline fixture: setup is isolated and never reads a credential or performs HTTP.
--disable_query_log
SELECT AUTO_INCREMENT INTO @ai_embedding_fixture_next_config_id
  FROM INFORMATION_SCHEMA.TABLES
 WHERE TABLE_SCHEMA = 'mysql'
   AND TABLE_NAME = 'alisql_ai_model_config';
SELECT AUTO_INCREMENT INTO @ai_embedding_fixture_next_audit_id
  FROM INFORMATION_SCHEMA.TABLES
 WHERE TABLE_SCHEMA = 'mysql'
   AND TABLE_NAME = 'alisql_ai_call_audit';
DELETE a
  FROM mysql.alisql_ai_call_audit AS a
  JOIN mysql.alisql_ai_model_config AS c ON c.config_id = a.config_id
 WHERE c.model_name = 'mtr/fixture-embedding';
DELETE b
  FROM mysql.alisql_ai_tenant_binding AS b
  JOIN mysql.alisql_ai_model_config AS c ON c.config_id = b.config_id
 WHERE c.model_name = 'mtr/fixture-embedding';
DELETE FROM mysql.alisql_ai_model_config
 WHERE model_name = 'mtr/fixture-embedding';
DELETE FROM mysql.alisql_ai_tenant_account
 WHERE account_user = 'ai_embedding_tester' AND account_host = 'localhost';
--disable_warnings
DROP USER IF EXISTS 'ai_embedding_tester'@'localhost';
--enable_warnings
SET @ai_embedding_fixture_old_vidx_disabled = @@GLOBAL.vidx_disabled;
SET GLOBAL vidx_disabled = OFF;
--enable_query_log

CREATE USER 'ai_embedding_tester'@'localhost';
GRANT AI_INVOKE ON *.* TO 'ai_embedding_tester'@'localhost';
GRANT AI_AUDIT_VIEWER ON *.* TO 'ai_embedding_tester'@'localhost';

INSERT INTO mysql.alisql_ai_model_config
  (config_version, model_name, capability, provider, provider_model_name,
   endpoint_type, endpoint, credential_kind, credential_ref, dimension,
   embedding_space_id, distance_metric, active)
VALUES
  (1, 'mtr/fixture-embedding', 'TEXT_EMBEDDING', 'mtr', 'fixture-embedding',
   'HTTPS_JSON', 'https://db4ai-mtr-fixture.invalid/v1/embeddings',
   'SECRET_REF', 'mtr/not-read', 1024,
   'mtr/fixture-embedding/current/1024/cosine', 'COSINE', TRUE);
SET @ai_embedding_fixture_config_id = LAST_INSERT_ID();
INSERT INTO mysql.alisql_ai_tenant_binding
  (tenant_id, model_name, capability, config_id, active)
VALUES
  (0, 'mtr/fixture-embedding', 'TEXT_EMBEDDING',
   @ai_embedding_fixture_config_id, TRUE);
INSERT INTO mysql.alisql_ai_tenant_account
  (account_user, account_host, tenant_id, active)
VALUES ('ai_embedding_tester', 'localhost', 0, TRUE);

--connect (embedding,localhost,ai_embedding_tester,,test)
--disable_query_log
SET transaction_isolation = 'READ-COMMITTED';
--enable_query_log
--echo # The resolved metadata exposes the fixed fixture dimension, not a secret or endpoint override.
SELECT JSON_UNQUOTE(JSON_EXTRACT(AI_MODEL_INFO('mtr/fixture-embedding'), '$.model_name')),
       JSON_EXTRACT(AI_MODEL_INFO('mtr/fixture-embedding'), '$.dimension'),
       JSON_UNQUOTE(JSON_EXTRACT(AI_MODEL_INFO('mtr/fixture-embedding'), '$.distance_metric'));

--echo # The Debug-only fixture returns a deterministic vector through the normal SQL, audit, and codec path.
SET @embedding = AI_EMBEDDING(
  'offline embedding regression probe', 'mtr/fixture-embedding', 1024);
SELECT VECTOR_DIM(@embedding) AS dimension,
       VEC_DISTANCE_COSINE(@embedding, @embedding) AS self_distance;
SELECT JSON_CONTAINS_PATH(AI_AUDIT_INFO(100), 'one', '$[0].endpoint',
                          '$[0].credential_ref', '$[0].input')
       AS audit_contains_sensitive_fields;

--echo # The AI result is convertible to text and supports the explicit Euclidean distance function.
SELECT LEFT(VEC_TOTEXT(@embedding), 4) = '[1,0' AS vector_text_prefix_is_expected,
       VEC_DISTANCE_EUCLIDEAN(@embedding, @embedding) AS euclidean_self_distance;

--echo # The AI result can be stored and searched through a cosine VECTOR INDEX with automatic distance selection.
CREATE TABLE ai_embedding_vector_probe (
  id INT NOT NULL PRIMARY KEY,
  embedding VECTOR(1024) NOT NULL,
  VECTOR INDEX ix_embedding (embedding) m=3 distance=cosine
) ENGINE=InnoDB;
INSERT INTO ai_embedding_vector_probe VALUES (1, @embedding);
SELECT id, VEC_DISTANCE(embedding, @embedding) AS indexed_auto_distance
  FROM ai_embedding_vector_probe FORCE INDEX (ix_embedding)
 ORDER BY VEC_DISTANCE(embedding, @embedding), id;
DROP TABLE ai_embedding_vector_probe;
--disconnect embedding
--connection default

--echo # A fixed-dimension profile rejects a mismatched request and completes a failed audit record.
--connect (embedding,localhost,ai_embedding_tester,,test)
--error ER_NOT_SUPPORTED_YET
SELECT AI_EMBEDDING(
  'offline embedding regression probe', 'mtr/fixture-embedding', 512);
SELECT AI_EMBEDDING(NULL, 'mtr/fixture-embedding', 1024);
--disconnect embedding
--connection default
SELECT status, error_code, total_tokens, http_status,
       completed_at IS NOT NULL AS completed
  FROM mysql.alisql_ai_call_audit
 WHERE config_id = @ai_embedding_fixture_config_id
 ORDER BY call_id;

--echo # Resource cleanup leaves no user, account mapping, Profile binding, Profile, or audit record.
DELETE FROM mysql.alisql_ai_call_audit
 WHERE config_id = @ai_embedding_fixture_config_id;
DELETE FROM mysql.alisql_ai_tenant_binding
 WHERE config_id = @ai_embedding_fixture_config_id;
DELETE FROM mysql.alisql_ai_tenant_account
 WHERE account_user = 'ai_embedding_tester' AND account_host = 'localhost';
DELETE FROM mysql.alisql_ai_model_config
 WHERE config_id = @ai_embedding_fixture_config_id;
SET GLOBAL vidx_disabled = @ai_embedding_fixture_old_vidx_disabled;
--disable_query_log
SET @ai_embedding_fixture_sql = CONCAT(
  'ALTER TABLE mysql.alisql_ai_model_config AUTO_INCREMENT = ',
  @ai_embedding_fixture_next_config_id);
PREPARE ai_embedding_fixture_stmt FROM @ai_embedding_fixture_sql;
EXECUTE ai_embedding_fixture_stmt;
DEALLOCATE PREPARE ai_embedding_fixture_stmt;
SET @ai_embedding_fixture_sql = CONCAT(
  'ALTER TABLE mysql.alisql_ai_call_audit AUTO_INCREMENT = ',
  @ai_embedding_fixture_next_audit_id);
PREPARE ai_embedding_fixture_stmt FROM @ai_embedding_fixture_sql;
EXECUTE ai_embedding_fixture_stmt;
DEALLOCATE PREPARE ai_embedding_fixture_stmt;
--enable_query_log
DROP USER 'ai_embedding_tester'@'localhost';
