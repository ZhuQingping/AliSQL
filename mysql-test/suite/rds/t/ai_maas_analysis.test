SET GLOBAL rds_ai_maas = ON;
--echo # AI_ANALYZE requires model_name and prompt, with optional public options.
--error ER_WRONG_PARAMCOUNT_TO_NATIVE_FCT
SELECT AI_ANALYZE('mtr/fixture-chat');

--echo # NULL values short-circuit before privilege, profile, audit, or egress.
SELECT AI_ANALYZE(NULL, 'prompt') AS null_model;
SELECT AI_ANALYZE('mtr/fixture-chat', NULL) AS null_prompt;

GRANT AI_INVOKE, AI_ADMIN ON *.* TO 'root'@'localhost';
CALL dbms_ai.register_model('mtr/fixture-chat', 'TEXT_GENERATION', 'mtr',
                            'fixture-chat',
                            'https://db4ai-mtr-fixture.invalid/v2/chat/completions', 0, '{}');

--echo # The two-argument form uses default provider request limits.
SELECT AI_ANALYZE('mtr/fixture-chat',
                  'Summarize the supplied evidence in one sentence.')
  AS two_argument_result;

--echo # The options form exposes only output and local transport limits.
SELECT AI_ANALYZE('mtr/fixture-chat',
                  'Summarize the supplied evidence in one sentence.',
                  JSON_OBJECT('max_output_tokens', 256,
                              'timeout_ms', 60000)) AS options_result;

--echo # An empty object uses defaults; a SQL NULL options value short-circuits.
SELECT AI_ANALYZE('mtr/fixture-chat', 'Use defaults.', '{}') AS empty_options_result;
SELECT AI_ANALYZE('mtr/fixture-chat', 'prompt', NULL) AS null_options;

--echo # Empty model and prompt are rejected before an invocation.
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('', 'prompt');
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('mtr/fixture-chat', '');

--echo # Options are an object with two bounded public keys only.
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('mtr/fixture-chat', JSON_OBJECT('rows', 1));
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('mtr/fixture-chat', 'prompt', JSON_ARRAY(1));
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('mtr/fixture-chat', 'prompt', '');
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('mtr/fixture-chat', 'prompt',
                  '{"timeout_ms":1000,"timeout_ms":2000}');
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('mtr/fixture-chat', 'prompt',
                  JSON_OBJECT('max_output_tokens', 0));
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('mtr/fixture-chat', 'prompt',
                  JSON_OBJECT('max_output_tokens', 32769));
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('mtr/fixture-chat', 'prompt', JSON_OBJECT('timeout_ms', 0));
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('mtr/fixture-chat', 'prompt',
                  JSON_OBJECT('timeout_ms', 60001));
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('mtr/fixture-chat', 'prompt',
                  JSON_OBJECT('temperature', 0));

--echo # Old model/mode/result-shaping fields are not silently retained.
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('mtr/fixture-chat', 'prompt',
                  JSON_OBJECT('model_name', 'mtr/fixture-chat'));
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('mtr/fixture-chat', 'prompt', JSON_OBJECT('mode', 'rag'));
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('mtr/fixture-chat', 'prompt',
                  JSON_OBJECT('output_format', 'json'));
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('mtr/fixture-chat', 'prompt',
                  JSON_OBJECT('return_sources', true));

--echo # The former task/input/options invocation is not accepted as a legacy form.
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('Summarize only supplied aggregates.',
                  JSON_OBJECT('rows', 1),
                  JSON_OBJECT('model_name', 'mtr/fixture-chat',
                              'mode', 'analyze'));

CALL dbms_ai.delete_model('mtr/fixture-chat', 'TEXT_GENERATION');
SET GLOBAL rds_ai_maas = OFF;
