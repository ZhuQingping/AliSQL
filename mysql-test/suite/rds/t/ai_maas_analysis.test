--echo # Omitting the options model is rejected before fixture setup, audit, credential lookup, or HTTP.
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('task', JSON_OBJECT('rows', 1));
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('task', JSON_OBJECT('rows', 1), JSON_OBJECT('mode', 'analyze'));

GRANT AI_INVOKE, AI_ADMIN ON *.* TO 'root'@'localhost';
INSERT INTO mysql.taurusdb_ai_model_config
  (model_name, provider, capability, provider_model_name, endpoint_url,
   credential_mode, credential_ref, status)
VALUES
  ('mtr/fixture-chat', 'mtr', 'TEXT_GENERATION', 'fixture-chat',
   'https://db4ai-mtr-fixture.invalid/v2/chat/completions',
   'SECRET_REF', 'mtr/not-read', 'ACTIVE');

--echo # Bounded aggregate JSON reaches the stable analyze mode.
SELECT AI_ANALYZE(
  'Summarize only the supplied aggregates.',
  JSON_OBJECT('period', '2026-07',
              'rows', JSON_ARRAY(JSON_OBJECT('region', 'cn-north',
                                              'orders', 12))),
  JSON_OBJECT('model_name', 'mtr/fixture-chat', 'mode', 'analyze',
              'output_format', 'json', 'max_output_tokens', 128))
  AS analysis_result;

--echo # Diagnosis returns evidence only and is not an automatic repair path.
SELECT AI_ANALYZE(
  'Return evidence and risk only. Do not execute or propose a repair.',
  JSON_OBJECT('sql_digest', 'SELECT * FROM orders WHERE tenant_id = ?',
              'explain', 'range scan', 'elapsed_ms', 4210,
              'rows_examined', 900000, 'lock_wait_ms', 0,
              'io', JSON_OBJECT('read_pages', 44)),
  JSON_OBJECT('model_name', 'mtr/fixture-chat', 'mode', 'diagnose',
              'output_format', 'json', 'max_output_tokens', 128))
  AS diagnosis_result;

--echo # An adversarial provider repair statement is rejected locally.
--error ER_NOT_SUPPORTED_YET
SELECT AI_ANALYZE(
  'Diagnose the supplied evidence only.',
  JSON_OBJECT('fixture', 'mtr_fixture_repair_sql', 'elapsed_ms', 4210),
  JSON_OBJECT('model_name', 'mtr/fixture-chat', 'mode', 'diagnose',
              'output_format', 'json'));

--echo # Diagnose requires a JSON object evidence bundle.
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE(
  'Diagnose only supplied evidence.',
  JSON_ARRAY(JSON_OBJECT('elapsed_ms', 4210)),
  JSON_OBJECT('model_name', 'mtr/fixture-chat', 'mode', 'diagnose',
              'output_format', 'json'));

--echo # Source provenance is a RAG JSON-only output feature.
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE(
  'Analyze supplied aggregates.', JSON_OBJECT('rows', 1),
  JSON_OBJECT('model_name', 'mtr/fixture-chat', 'mode', 'analyze',
              'output_format', 'json', 'return_sources', true));

--echo # Provider-private options remain outside the SQL contract.
--error ER_WRONG_ARGUMENTS
SELECT AI_ANALYZE('task', JSON_OBJECT('rows', JSON_ARRAY()),
                  JSON_OBJECT('model_name', 'mtr/fixture-chat',
                              'temperature', 0));

DELETE FROM mysql.taurusdb_ai_model_config WHERE model_name = 'mtr/fixture-chat';
