JSON_OBJECT('fixture', 'mtr_fixture_commented_whitespace_alter'),
JSON_OBJECT('model_name', 'mtr/fixture-chat', 'mode', 'diagnose',
'output_format', 'json'));
ERROR 42000: This version of MySQL doesn't yet support 'DB4AI diagnosis output violated the read-only contract'
