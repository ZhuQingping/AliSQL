# Omitting the options model is rejected before fixture setup, audit, credential lookup, or HTTP.
SELECT AI_ANALYZE('task', JSON_OBJECT('rows', 1));
ERROR HY000: Incorrect arguments to ai_analyze
SELECT AI_ANALYZE('task', JSON_OBJECT('rows', 1), JSON_OBJECT('mode', 'analyze'));
ERROR HY000: Incorrect arguments to ai_analyze
GRANT AI_INVOKE, AI_ADMIN ON *.* TO 'root'@'localhost';
INSERT INTO mysql.taurusdb_ai_model_config
(model_name, provider, capability, provider_model_name, endpoint_url,
credential_mode, credential_ref, status)
VALUES
('mtr/fixture-chat', 'mtr', 'TEXT_GENERATION', 'fixture-chat',
'https://db4ai-mtr-fixture.invalid/v2/chat/completions',
'SECRET_REF', 'mtr/not-read', 'ACTIVE');
# Bounded aggregate JSON reaches the stable analyze mode.
SELECT AI_ANALYZE(
'Summarize only the supplied aggregates.',
JSON_OBJECT('period', '2026-07',
'rows', JSON_ARRAY(JSON_OBJECT('region', 'cn-north',
'orders', 12))),
JSON_OBJECT('model_name', 'mtr/fixture-chat', 'mode', 'analyze',
'output_format', 'json', 'max_output_tokens', 128))
AS analysis_result;
analysis_result
{"content":"offline analysis","model_name":"mtr/fixture-chat","config_version":1,"usage":{"prompt_tokens":0,"completion_tokens":0,"reasoning_tokens":0,"cached_tokens":0,"total_tokens":1}}
# Diagnosis returns evidence only and is not an automatic repair path.
SELECT AI_ANALYZE(
'Return evidence and risk only. Do not execute or propose a repair.',
JSON_OBJECT('sql_digest', 'SELECT * FROM orders WHERE tenant_id = ?',
'explain', 'range scan', 'elapsed_ms', 4210,
'rows_examined', 900000, 'lock_wait_ms', 0,
'io', JSON_OBJECT('read_pages', 44)),
JSON_OBJECT('model_name', 'mtr/fixture-chat', 'mode', 'diagnose',
'output_format', 'json', 'max_output_tokens', 128))
AS diagnosis_result;
diagnosis_result
{"content":"offline diagnosis: evidence only","model_name":"mtr/fixture-chat","config_version":1,"usage":{"prompt_tokens":0,"completion_tokens":0,"reasoning_tokens":0,"cached_tokens":0,"total_tokens":1}}
# An adversarial provider repair statement is rejected locally.
SELECT AI_ANALYZE(
'Diagnose the supplied evidence only.',
JSON_OBJECT('fixture', 'mtr_fixture_repair_sql', 'elapsed_ms', 4210),
JSON_OBJECT('model_name', 'mtr/fixture-chat', 'mode', 'diagnose',
'output_format', 'json'));
ERROR 42000: This version of MySQL doesn't yet support 'DB4AI diagnosis output violated the read-only contract'
