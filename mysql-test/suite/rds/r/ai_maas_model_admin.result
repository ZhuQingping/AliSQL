# dbms_ai accepts only the governed model-management package.
DROP USER IF EXISTS 'ai_model_admin_dml'@'localhost';
CREATE USER 'ai_model_admin_dml'@'localhost';
CREATE USER 'ai_model_admin_super'@'localhost';
GRANT SELECT, INSERT, UPDATE, DELETE ON mysql.taurusdb_ai_model_config
TO 'ai_model_admin_dml'@'localhost';
GRANT SUPER ON *.* TO 'ai_model_admin_super'@'localhost';
Warnings:
Warning	1287	The SUPER privilege identifier is deprecated
# Table DML alone cannot administer models through the package.
CALL dbms_ai.register_model('mtr/model-admin-forbidden-embedding', 'TEXT_EMBEDDING',
'fixture-embedding', 'SECRET_REF', 'mtr/not-read');
ERROR 42000: Access denied; you need (at least one of) the AI_ADMIN privilege(s) for this operation
CALL dbms_ai.show_models();
ERROR 42000: Access denied; you need (at least one of) the AI_ADMIN privilege(s) for this operation
GRANT AI_ADMIN ON *.* TO 'root'@'localhost';
CALL dbms_ai.register_model('huawei/mtr-model-admin-generation', 'TEXT_GENERATION',
'glm-5.2', 'SECRET_REF', 'mtr/not-read');
# Duplicate names and unsupported embedding profiles are rejected locally.
CALL dbms_ai.register_model('huawei/mtr-model-admin-generation', 'TEXT_GENERATION',
'glm-5.2', 'SECRET_REF', 'mtr/not-read');
ERROR HY000: Incorrect arguments to duplicate dbms_ai model
CALL dbms_ai.register_model('huawei/mtr-invalid-embedding', 'TEXT_EMBEDDING',
'not-bge-m3', 'SECRET_REF', 'mtr/not-read');
ERROR HY000: Incorrect arguments to dbms_ai model request
# PLAINTEXT_DEV is accepted by this Debug-only package test but never invoked.
CALL dbms_ai.register_model('huawei/mtr-plaintext-dev', 'TEXT_GENERATION',
'glm-5.2', 'PLAINTEXT_DEV', 'dev-only-not-invoked');
SELECT credential_mode
FROM mysql.taurusdb_ai_model_config
WHERE model_name = 'huawei/mtr-plaintext-dev' AND status = 'ACTIVE';
credential_mode
PLAINTEXT_DEV
CALL dbms_ai.delete_model('huawei/mtr-plaintext-dev', 'TEXT_GENERATION');
# The public model list exposes exactly safe lifecycle metadata.
CALL dbms_ai.show_models();
MODEL_NAME	CAPABILITY	PROVIDER_MODEL_NAME	DIMENSION	CONFIG_VERSION
huawei/mtr-model-admin-generation	TEXT_GENERATION	glm-5.2	NULL	1
CALL dbms_ai.update_model('huawei/mtr-model-admin-generation', 'TEXT_GENERATION',
'kimi-k2.6', 'SECRET_REF', 'mtr/not-read');
# Updating exposes only the replacement active configuration.
CALL dbms_ai.show_models();
MODEL_NAME	CAPABILITY	PROVIDER_MODEL_NAME	DIMENSION	CONFIG_VERSION
huawei/mtr-model-admin-generation	TEXT_GENERATION	kimi-k2.6	NULL	2
# Resolution observes only the successor and cannot invoke a provider.
SELECT JSON_EXTRACT(AI_MODEL_INFO('huawei/mtr-model-admin-generation'), '$.config_version');
JSON_EXTRACT(AI_MODEL_INFO('huawei/mtr-model-admin-generation'), '$.config_version')
2
# A successor write failure rolls back and leaves version 2 active.
SET SESSION debug = '+d,inject_error_ha_write_row';
CALL dbms_ai.update_model('huawei/mtr-model-admin-generation', 'TEXT_GENERATION',
'should-not-persist', 'SECRET_REF', 'mtr/not-read');
ERROR HY000: Unknown error
SET SESSION debug = '-d,inject_error_ha_write_row';
SELECT JSON_EXTRACT(AI_MODEL_INFO('huawei/mtr-model-admin-generation'), '$.config_version');
JSON_EXTRACT(AI_MODEL_INFO('huawei/mtr-model-admin-generation'), '$.config_version')
2
CALL dbms_ai.delete_model('huawei/mtr-model-admin-generation', 'TEXT_GENERATION');
# Deleting retires every version from the public model list.
CALL dbms_ai.show_models();
MODEL_NAME	CAPABILITY	PROVIDER_MODEL_NAME	DIMENSION	CONFIG_VERSION
SELECT AI_MODEL_INFO('huawei/mtr-model-admin-generation');
ERROR 42000: This version of MySQL doesn't yet support 'DB4AI model configuration was not found'
REVOKE SELECT, INSERT, UPDATE, DELETE ON mysql.taurusdb_ai_model_config
FROM 'ai_model_admin_dml'@'localhost';
DROP USER 'ai_model_admin_dml'@'localhost';
DROP USER 'ai_model_admin_super'@'localhost';
