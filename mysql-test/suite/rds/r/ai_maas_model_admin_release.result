# This test deliberately has no Debug fixture or keyring dependency.
# It validates the production control-plane shape in every build type.
SET GLOBAL rds_ai_maas = ON;
GRANT AI_ADMIN ON *.* TO 'root'@'localhost';
# Publishing a Huawei Profile stores no credential with the model.
CALL dbms_ai.register_model('huawei/release-control-plane', 'TEXT_EMBEDDING',
'huawei', 'bge-m3',
'https://api.modelarts-maas.com/v1/embeddings', 1024, '{}');
SELECT JSON_EXTRACT(AI_MODEL_INFO('huawei/release-control-plane'), '$.config_version');
JSON_EXTRACT(AI_MODEL_INFO('huawei/release-control-plane'), '$.config_version')
1
SELECT api_key_plaintext FROM mysql.ai_model_config;
ERROR 42S22: Unknown column 'api_key_plaintext' in 'field list'
# An endpoint outside the provider allowlist cannot be published.
CALL dbms_ai.register_model('huawei/release-bad-endpoint', 'TEXT_GENERATION',
'huawei', 'glm-5.2',
'https://api.modelarts-maas.com/v1/embeddings', 0, '{}');
ERROR HY000: Incorrect arguments to dbms_ai model request
CALL dbms_ai.show_models();
MODEL_NAME	CAPABILITY	PROVIDER_MODEL_NAME	DIMENSION	CONFIG_VERSION
huawei/release-control-plane	TEXT_EMBEDDING	bge-m3	1024	1
SELECT AI_MODEL_INFO('huawei/release-bad-endpoint');
ERROR 42000: This version of MySQL doesn't yet support 'DB4AI model configuration was not found'
CALL dbms_ai.delete_model('huawei/release-control-plane', 'TEXT_EMBEDDING');
SET GLOBAL rds_ai_maas = OFF;
